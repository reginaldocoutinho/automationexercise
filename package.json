{
  "name": "automationexercise",
  "version": "1.0.0",
  "main": "cypress.config.js",
"scripts": {
  "cleanup:reports": "rimraf cypress/results",
  "cy:run": "npx cypress run",
  "merge:reports": "npx mochawesome-merge cypress/results/json/*.json > cypress/results/merged-report.json",
  "generate:report": "npx marge cypress/results/merged-report.json --reportDir cypress/results/html --inline",
  "test:report": "npm run cleanup:reports && npm run cy:run && npm run merge:reports && npm run generate:report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reginaldocoutinho/automationexercise.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/reginaldocoutinho/automationexercise/issues"
  },
  "homepage": "https://github.com/reginaldocoutinho/automationexercise#readme",
  "description": "",
  "devDependencies": {
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.0",
    "mochawesome-report-generator": "^6.3.2",
    "rimraf": "^6.1.2"
  }
}
